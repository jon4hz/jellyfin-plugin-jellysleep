{
    // Paths and plugin name are configured in settings.json
    "version": "2.0.0",
    "tasks": [
        {
            // Build the plugin, then install it into the jellyfin data dir
            "label": "build-and-copy",
            "dependsOrder": "sequence",
            "dependsOn": ["build", "copy-plugin"]
        },
        {
            // dotnet publish defaults to Release; the csproj's CreatePluginPackage
            // target collects exactly the files the plugin ships into bin/plugin/
            "label": "build",
            "command": "dotnet",
            "type": "shell",
            "args": ["publish", "${workspaceFolder}/${config:pluginName}.sln", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
            "group": "build",
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile"
        },
        {
            // Replace the installed plugin with exactly the files of the release zip
            // (dll, xml docs, bundled dependencies); a clean dir avoids stale DLLs
            "label": "copy-plugin",
            "type": "shell",
            "command": "rm -rf \"${config:jellyfinDataDir}/plugins/${config:pluginName}\" && mkdir -p \"${config:jellyfinDataDir}/plugins/${config:pluginName}\" && cp ${workspaceFolder}/bin/plugin/* \"${config:jellyfinDataDir}/plugins/${config:pluginName}/\""
        }
    ]
}
